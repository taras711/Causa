# Ollama s předem staženými modely
# Hodnoty se předávají přes --build-arg; výchozí hodnoty odpovídají configs/models.yaml (jediný zdroj pravdy)
FROM ollama/ollama:latest

ARG MODEL_SMALL=qwen3.5:4b
ARG MODEL_LARGE=qwen3:14b
ARG MODEL_COMPLEX=hf.co/Qwen/Qwen3-14B-GGUF:Q5_K_M
ARG MODEL_EMBEDDING=nomic-embed-text

# Modely se stáhnou při prvotním spuštění přes entrypoint
ENV OLLAMA_MODELS=${MODEL_SMALL},${MODEL_LARGE},${MODEL_COMPLEX},${MODEL_EMBEDDING}

EXPOSE 11434

# Entrypoint spustí Ollama a stáhne konfigurované modely
COPY scripts/pull_models.sh /usr/local/bin/pull_models.sh
RUN chmod +x /usr/local/bin/pull_models.sh
ENTRYPOINT ["/usr/local/bin/pull_models.sh"]