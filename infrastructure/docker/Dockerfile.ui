# Webové UI (Node.js + Vite build) – placeholder pro pozdější implementaci
FROM node:20-alpine AS builder

WORKDIR /app
COPY ui/package*.json ./
RUN npm ci

COPY ui/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]