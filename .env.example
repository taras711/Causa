# Causa – proměnné prostředí (kopírovat jako .env a upravit)
# Nikdy necommitovat reálné hodnoty do gitu.

# Obecné
CAUSA_ENV=dev
CAUSA_LOG_LEVEL=INFO
CAUSA_SECRET_KEY=zmenit-v-produkci

# Databáze
DATABASE_URL=sqlite:///./data/sqlite/causa.db
# PROD: postgresql+psycopg2://causa:heslo@localhost:5432/causa

# Ollama (lokální LLM runtime)
OLLAMA_BASE_URL=http://localhost:11434
CAUSA_MODEL_SMALL=qwen2.5:3b
CAUSA_MODEL_LARGE=qwen2.5:14b
CAUSA_MODEL_EMBEDDING=nomic-embed-text

# API
CAUSA_API_HOST=0.0.0.0
CAUSA_API_PORT=8000

# UI (web / desktop)
CAUSA_UI_PORT=3000

# Tenant (pro serverové nasazení)
CAUSA_TENANT_ID=default

# Zálohy
CAUSA_BACKUP_DIR=./data/backups
CAUSA_BACKUP_ENCRYPTION_KEY=zmenit-v-produkci

# Monitoring (volitelné, fáze 2+)
CAUSA_PROMETHEUS_PORT=9090